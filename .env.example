# =====================================================================
# .env.example : 서버 .env 견본 (10단계) — [추가]2026.11.13권성애
#
# ★ 이 파일은 "이름만" 적은 견본이라 GitHub 에 올려도 된다. 값은 절대 쓰지 않는다.
# ★ 서버에서:  cp .env.example .env  →  nano .env 로 값 채우기  →  chmod 600 .env
#   docker compose 는 같은 폴더의 .env 를 자동으로 읽어 docker-compose.yml 의 ${이름} 에 넣는다.
#
# 규칙
#   - 이름=값 (= 앞뒤에 띄어쓰기 없음), 따옴표 없이
#   - 비밀번호에 $ 는 쓰지 않기 (compose 가 변수로 착각함). 영문 대소문자 + 숫자 + _ - 권장
#   - # 으로 시작하는 줄은 주석
# =====================================================================

# ----- 앱 이미지 (GitHub Actions 가 push 한 이미지) -----
# ghcr.io/깃허브아이디/bustour:latest  ← 아이디는 반드시 소문자
APP_IMAGE=ghcr.io/githubid/bustour:latest

# ----- MySQL -----
# root 비밀번호: MySQL 컨테이너 관리용 (앱은 쓰지 않음)
MYSQL_ROOT_PASSWORD=
# 앱 전용 계정 (MySQL 컨테이너가 처음 뜰 때 이 이름 · 비밀번호로 만들어 준다)
DB_USERNAME=bustour
DB_PASSWORD=

# ----- 결제 -----
# fake = 가짜 PG / toss = 토스 테스트 키 (test_ 로 시작하지 않는 키면 앱이 뜨지 않음)
PG_TYPE=toss
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ----- 기상청 (공공데이터포털 일반 인증키 Decoding) -----
KMA_SERVICE_KEY=

# ----- Let's Encrypt 인증서 만료 안내 메일 -----
CERTBOT_EMAIL=
